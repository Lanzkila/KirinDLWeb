KIRINDL_ALLOWED_ORIGINS=https://lanzkila.github.io,http://127.0.0.1:4173,http://localhost:4173
# Never publish this token in GitHub Pages JavaScript.
KIRINDL_API_TOKEN=
# Mount a persistent volume at this path. SQLite task records and output files live here.
KIRINDL_DATA_DIR=/data
KIRINDL_MAX_WORKERS=2
KIRINDL_MAX_ACTIVE_TASKS=3
KIRINDL_MAX_DOWNLOAD_BYTES=2147483648
KIRINDL_MIN_FREE_DISK_BYTES=536870912
KIRINDL_TASK_TIMEOUT_SECONDS=3600
KIRINDL_RETENTION_SECONDS=86400
KIRINDL_CLEANUP_INTERVAL_SECONDS=300
# Local development can leave Turnstile disabled. Production must enable it.
KIRINDL_REQUIRE_TURNSTILE=false
KIRINDL_TURNSTILE_SECRET=
KIRINDL_TURNSTILE_HOSTNAMES=lanzkila.github.io
