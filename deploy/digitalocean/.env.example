# Set this to a domain you control, with an A record pointing to the Droplet IPv4.
KIRINDL_API_DOMAIN=api.example.com

# Allow only website origins that are actually used in production.
KIRINDL_ALLOWED_ORIGINS=https://lanzkila.github.io

KIRINDL_DATA_DIR=/data
KIRINDL_MAX_WORKERS=1
KIRINDL_MAX_ACTIVE_TASKS=1
KIRINDL_MAX_DOWNLOAD_BYTES=2147483648
KIRINDL_MIN_FREE_DISK_BYTES=1073741824
KIRINDL_TASK_TIMEOUT_SECONDS=3600
KIRINDL_RETENTION_SECONDS=86400
KIRINDL_CLEANUP_INTERVAL_SECONDS=300

# Production requires Cloudflare Turnstile. The secret never goes in website JS.
KIRINDL_REQUIRE_TURNSTILE=true
KIRINDL_TURNSTILE_SECRET=replace-with-your-cloudflare-turnstile-secret
KIRINDL_TURNSTILE_HOSTNAMES=lanzkila.github.io

# Leave empty unless a trusted private gateway is configured.
KIRINDL_API_TOKEN=
